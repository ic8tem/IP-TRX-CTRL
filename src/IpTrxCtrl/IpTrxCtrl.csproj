<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>IpTrxCtrl</RootNamespace>
    <AssemblyName>IP-TRX-CTRL</AssemblyName>
    <Product>IP-TRX-CTRL</Product>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- niente dipendenza da ICU su Linux/Raspberry -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- Open.NAT e' compilato per .NET Framework ma funziona su .NET 8; CA1416: le API per sistema sono protette da controlli OperatingSystem.Is* -->
    <NoWarn>$(NoWarn);NU1701;CA1416</NoWarn>
  </PropertyGroup>

  <!-- Eseguibile unico e autonomo (dotnet publish -r <rid>) -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <PackageReference Include="Open.NAT" Version="2.1.0" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="notices/THIRD-PARTY-NOTICES.txt" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="notices/LICENSE" />
    <!-- pagina web (accesso dal browser): servita dal server; «trova-server.html» si salva anche su file -->
    <EmbeddedResource Include="web\**\*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Hamlib per Windows (rigctld, rigctl, DLL, licenze): la cartella hamlib viene preparata dalla compilazione -->
  <ItemGroup Condition="Exists('hamlib\rigctld.exe')">
    <EmbeddedResource Include="hamlib\*" LogicalName="hamlib/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
